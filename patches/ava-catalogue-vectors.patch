+/// `e`'s package from the seed, if the seed has exactly it (by sha256).
+pub fn seed_package(e: &Entry) -> Option<(Vec<u8>, String)> {
+    package_in(&seed_dir()?, e)
+}
+
+/// `e`'s package from catalogue folder `dir`, if it has exactly it (by sha256).
+pub fn package_in(dir: &Path, e: &Entry) -> Option<(Vec<u8>, String)> {
+    if !manifest::valid_bundle_path(&e.package.file) {
+        return None;
+    }
+    let bytes = std::fs::read(dir.join(&e.package.file)).ok()?;
+    if bytes.len() as u64 != e.package.bytes || hex(&Sha256::digest(&bytes)) != e.package.sha256 {
+        return None;
+    }
+    let sig = std::fs::read_to_string(dir.join(format!("{}.sig", e.package.file))).ok()?;
+    Some((bytes, sig))
+}
+
+/// The add-ons in a seed (`src-tauri/catalogue-seed`, production-signed),
+/// checked as an install is and written under `into`: their bundles, for
+/// `ava-qa`'s dev catalogue now that Notebook isn't built in this repo.
+pub fn unpack_seed(seed: &Path, into: &Path) -> Result<Vec<PathBuf>, String> {
+    let keys = production_keys();
+    let (index, _, _) = read_folder(seed, &keys, None)?;
+    let mut roots = Vec::new();
+    for e in &index.addons {
+        if let Some((bytes, sig)) = package_in(seed, e) {
+            roots.push(stage(into, &keys, e, &bytes, &sig)?.root);
+        }
+    }
+    Ok(roots)
+}
