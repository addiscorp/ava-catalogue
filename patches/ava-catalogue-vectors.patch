+/// A listing asset as a data: URL (the main UI never loads anything from
+/// the web): from what Ava keeps, else from the add-on as installed, else
+/// the seed, else the catalogue; checked against the index every time, and
+/// kept once it's checked.
+pub async fn asset_data_url(data: &Path, a: &Asset, installed: Option<&Path>) -> Result<String, String> {
+    if !manifest::valid_bundle_path(&a.file) || !a.file.starts_with("assets/") {
+        return Err("That isn't a catalogue file.".into());
+    }
+    let kept = a.file.split('/').fold(cache_dir(data), |p, part| p.join(part));
+    let name = a.file.rsplit('/').next().unwrap_or_default().to_string();
+    let local = [Some(kept.clone()), installed.map(|r| r.join("listing").join(&name)), seed_dir().map(|s| a.file.split('/').fold(s, |p, part| p.join(part)))];
+    for path in local.into_iter().flatten() {
+        if let Ok(bytes) = std::fs::read(&path) {
+            if let Ok(t) = check_asset(a, &bytes) {
+                if path != kept {
+                    let _ = keep_asset(&kept, &bytes);
+                }
+                return Ok(data_url(t, &bytes));
+            }
+        }
+    }
+    let source = Source::current().ok_or("This Ava has no catalogue.")?;
+    let bytes = source.read(&a.file, a.bytes).await.map_err(|f| f.say())?;
+    let t = check_asset(a, &bytes)?;
+    keep_asset(&kept, &bytes)?;
+    Ok(data_url(t, &bytes))
+}
