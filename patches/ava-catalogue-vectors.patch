+/// Read `latest.json` (its shape only; `parse_latest` checks it against the index).
+pub fn parse_pointer(bytes: &[u8]) -> Result<Pointer, String> {
+    let p: Pointer = serde_json::from_slice(bytes).map_err(|_| "The catalogue's latest.json isn't readable.".to_string())?;
+    if p.format != FORMAT {
+        return Err("This catalogue is newer than this Ava.".into());
+    }
+    if p.index != format!("index/{}.json", p.version) || !hex64(&p.sha256) || p.bytes > INDEX_MAX {
+        return Err("The catalogue's latest.json isn't valid.".into());
+    }
+    Ok(p)
