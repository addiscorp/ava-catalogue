diff --git a/src-tauri/src/addons/catalogue_vectors.rs b/src-tauri/src/addons/catalogue_vectors.rs
new file mode 100644
index 0000000..d8338be
--- /dev/null
+++ b/src-tauri/src/addons/catalogue_vectors.rs
@@ -0,0 +1,116 @@
+//! The catalogue's test vectors: packages and indexes made by
+//! addiscorp/ava-catalogue's packer (`tools/pack`, TypeScript), signed with
+//! the TEST key, copied from its `vectors/` into `vectors/` here.
+//!
+//! Two implementations of one format must agree. These check that what the
+//! packer writes is what this crate verifies and installs, byte for byte
+//! (each file is what serde_json would write for the same values, and each
+//! signature is what `test_key::sign` gives), and that the four guards hold:
+//! a changed package, an index signed by another key, an older index, and a
+//! package whose manifest isn't what the index says.
+//!
+//! When the format changes, remake them there (`npm run vectors`) and copy
+//! `vectors/good`, `vectors/bad` and `vectors/cases.json` here.
+
+use std::path::{Path, PathBuf};
+
+use super::catalogue::{install, parse_index, test_key, Entry, Index, Package};
+
+/// The highest index version "seen before" in every case (cases.json `last`).
+const LAST: u64 = 100;
+
+fn dir(case: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("src/addons/vectors").join(case)
+}
+
+fn read(case: &str, file: &str) -> Vec<u8> {
+    std::fs::read(dir(case).join(file)).unwrap_or_else(|e| panic!("{case}/{file}: {e}"))
+}
+
+fn sig(case: &str, file: &str) -> String {
+    String::from_utf8(read(case, &format!("{file}.sig"))).unwrap()
+}
+
+/// A fresh data folder for installs.
+fn data(case: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("ava-vectors-{}-{}", std::process::id(), case.replace('/', "-")));
+    let _ = std::fs::remove_dir_all(&d);
+    d
+}
+
+fn index(case: &str) -> Result<Index, String> {
+    parse_index(&super::catalogue::key().unwrap(), &read(case, "index.json"), &sig(case, "index.json"), Some(LAST))
+}
+
+fn install_one(case: &str, e: &Entry, data: &Path) -> Result<super::Installed, String> {
+    install(data, &super::catalogue::key().unwrap(), e, &read(case, &e.package.file), &sig(case, &e.package.file))
+}
+
+#[test]
+fn the_vectors_are_what_this_crate_writes_and_signs() {
+    let bytes = read("good", "index.json");
+    let raw: Index = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(serde_json::to_vec_pretty(&raw).unwrap(), bytes, "the packer's index is serde_json's to_vec_pretty, byte for byte");
+    assert_eq!(test_key::sign(&bytes), sig("good", "index.json"), "and its signature is the one this crate makes");
+    assert_eq!(raw.addons.len(), 2);
+    for e in &raw.addons {
+        let pkg = read("good", &e.package.file);
+        let p: Package = serde_json::from_slice(&pkg).unwrap();
+        assert_eq!(serde_json::to_vec(&p).unwrap(), pkg, "{}: the packer's package is serde_json's to_vec, byte for byte (keys in BTreeMap order)", e.id);
+        assert_eq!(test_key::sign(&pkg), sig("good", &e.package.file), "{}", e.id);
+    }
+}
+
+#[test]
+fn the_good_vectors_verify_and_install() {
+    let index = index("good").unwrap();
+    assert_eq!((index.format, index.version), (1, LAST));
+    let ids: Vec<&str> = index.addons.iter().map(|e| e.id.as_str()).collect();
+    assert_eq!(ids, ["hello-notes", "pin-board"]);
+    let d = data("good");
+    for e in &index.addons {
+        let a = install_one("good", e, &d).unwrap_or_else(|err| panic!("{}: {err}", e.id));
+        assert_eq!((a.manifest.id.as_str(), a.manifest.version.as_str(), a.first_party), (e.id.as_str(), e.version.as_str(), false));
+        assert!(a.root.join(&a.manifest.entry).is_file(), "{}: its page was installed", e.id);
+    }
+    let notes = d.join("addons/installed/hello-notes");
+    for f in ["10", "1a.txt", "2", "assets/Z.txt", "assets/a b.txt", "assets/app.js", "icon.svg", "index.html", "manifest.json"] {
+        assert!(notes.join(f).is_file(), "hello-notes/{f}");
+    }
+    assert_eq!(std::fs::read_to_string(notes.join("assets/a b.txt")).unwrap(), "A space in a path.\n");
+    let board = index.addons.iter().find(|e| e.id == "pin-board").unwrap();
+    assert_eq!(board.egress, ["images.example.com", "*.cdn.example.com"]);
+    std::fs::remove_dir_all(d).unwrap();
+}
+
+#[test]
+fn a_tampered_package_is_refused() {
+    let index = index("bad/tampered-package").unwrap();
+    let e = index.addons.iter().find(|e| e.id == "hello-notes").unwrap();
+    let d = data("tampered");
+    assert!(install_one("bad/tampered-package", e, &d).unwrap_err().contains("doesn't match"), "changed after it was signed");
+    assert!(!d.join("addons/installed/hello-notes").exists());
+    let _ = std::fs::remove_dir_all(d);
+}
+
+#[test]
+fn an_index_signed_by_another_key_is_refused() {
+    assert!(index("bad/wrong-signature").unwrap_err().contains("doesn't match"));
+}
+
+#[test]
+fn an_older_index_is_refused() {
+    let err = index("bad/rollback").unwrap_err();
+    assert!(err.contains("older") && err.contains("99"), "{err}");
+    let older = parse_index(&super::catalogue::key().unwrap(), &read("bad/rollback", "index.json"), &sig("bad/rollback", "index.json"), None);
+    assert_eq!(older.unwrap().version, 99, "signed correctly: only its version is wrong");
+}
+
+#[test]
+fn a_package_that_asks_for_more_than_the_index_says_is_refused() {
+    let index = index("bad/manifest-mismatch").unwrap();
+    let e = index.addons.iter().find(|e| e.id == "hello-notes").unwrap();
+    let d = data("mismatch");
+    assert!(install_one("bad/manifest-mismatch", e, &d).unwrap_err().contains("something other than"));
+    let _ = std::fs::remove_dir_all(d);
+}
