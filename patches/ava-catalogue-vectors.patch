+
+/// The seed's index, checked as the catalogue's would be (latest.json, else
+/// index.json), with its signature and bytes. Read from disk, no network.
+pub fn read_folder(dir: &Path, keys: &[VerifyingKey], last: Option<u64>) -> Result<(Index, String, Vec<u8>), String> {
+    let read = |name: &str| std::fs::read(name.split('/').fold(dir.to_path_buf(), |p, part| p.join(part)));
+    match read(POINTER) {
+        Ok(pb) => {
+            let p = parse_pointer(&pb)?;
+            let bytes = read(&p.index).map_err(|_| format!("{} isn't there.", p.index))?;
+            let index = parse_latest(keys, &p, &bytes, last)?;
+            Ok((index, p.signature, bytes))
+        }
+        Err(_) => {
+            let bytes = read(LEGACY_INDEX).map_err(|_| "There's no catalogue index there.".to_string())?;
+            let sig = String::from_utf8(read("index.json.sig").map_err(|_| "The index has no signature.".to_string())?).map_err(|_| "The signature isn't readable.".to_string())?;
+            let index = parse_index(keys, &bytes, &sig, last)?;
+            Ok((index, sig, bytes))
+        }
+    }
+}
