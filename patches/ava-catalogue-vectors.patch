+
+/// The index `p` names: exactly those bytes (sha256 and size), signed by
+/// one of `keys` (the signature is the pointer's), format 2, of exactly the
+/// pointer's version, and never older than `last`.
+pub fn parse_latest(keys: &[VerifyingKey], p: &Pointer, bytes: &[u8], last: Option<u64>) -> Result<Index, String> {
+    if hex(&Sha256::digest(bytes)) != p.sha256 || bytes.len() as u64 != p.bytes {
+        return Err(format!("The catalogue's {} isn't the index latest.json names: refused.", p.index));
+    }
+    let index = parse_index(keys, bytes, &p.signature, last)?;
+    if index.format != FORMAT || index.version != p.version {
+        return Err(format!("The catalogue's {} is version {}, not the version {} latest.json names: refused.", p.index, index.version, p.version));
+    }
+    Ok(index)
+}
