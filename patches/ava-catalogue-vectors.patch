+/// What an asset is, from its first bytes: an SVG or a PNG, as its name says.
+fn picture_type(name: &str, bytes: &[u8]) -> Option<&'static str> {
+    if name.ends_with(".png") && bytes.starts_with(b"\x89PNG\r\n\x1a\n") {
+        return Some("image/png");
+    }
+    let head = String::from_utf8_lossy(&bytes[..bytes.len().min(512)]).trim_start().to_lowercase();
+    (name.ends_with(".svg") && (head.starts_with("<svg") || head.starts_with("<?xml"))).then_some("image/svg+xml")
+}
